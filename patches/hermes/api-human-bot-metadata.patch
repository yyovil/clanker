             return event.get("user") not in self._slack_api_human_users()
         return False
 
+    async def _normalize_api_human_sender(self, event: dict, team_id: str) -> Optional[dict]:
+        """User-token posts can carry app bot stamps despite a human ``user``. Remove those
+        stamps only after Slack confirms the allowlisted author, before every bot classifier.
+        A failed bot lookup's cached False is not proof of a human; verify this event afresh."""
+        user_id = event.get("user")
+        if (user_id not in self._slack_api_human_users() or not event.get("app_id")
+                or event.get("client_msg_id")):
+            return event
+        if (not team_id or team_id not in self._team_clients
+                or user_id == self._team_bot_user_ids.get(team_id, self._bot_user_id)
+                or event.get("subtype") == "bot_message"):
+            return None
+        event_profile = event.get("user_profile")
+        if isinstance(event_profile, dict) and event_profile.get("is_bot"):
+            return None
+        try:
+            payload = await self._users_info_payload(user_id, event.get("channel", ""), team_id)
+        except Exception:
+            logger.warning("[Slack] Cannot verify API human sender user=%s team=%s", user_id, team_id)
+            return None
+        user = payload.get("user")
+        if (payload.get("ok") is not True or not isinstance(user, dict)
+                or user.get("id") != user_id or user.get("team_id") != team_id
+                or user.get("is_bot") is not False or user.get("deleted") or user.get("is_app_user")):
+            return None
+        name, is_bot = self._parse_users_info(payload, user_id)
+        if is_bot:
+            return None
+        # Reuse this confirmed lookup for the downstream peer-bot/name checks. The admission
+        # exception itself remains event-scoped: future API posts still verify afresh.
+        cache_key = (team_id, user_id)
+        self._user_is_bot_cache[cache_key] = False
+        self._user_name_cache[cache_key] = name
+        normalized = dict(event)
+        normalized.pop("bot_id", None)
+        normalized.pop("bot_profile", None)
+        return normalized
+
     def _resolve_thread_ts(
