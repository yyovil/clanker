-            norm_origin = normalize_origin(origin)
-            if login_method == "sms":
-                phone = secret.get("phone_number")
-                if (set(secret) != {"phone_number"} or not isinstance(phone, str) or
-                        not re.fullmatch(r"\+?[0-9]{7,15}", phone) or urlsplit(norm_origin).scheme != "https"):
-                    raise VaultError("SMS logins require only a phone number and an HTTPS origin")
