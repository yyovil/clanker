-                secret = {"phone_number": phone}
-            elif login_method != "password":
-                raise VaultError("unsupported login method")
-            else:
-                secret, identifier_type, identifier = self._password_login(secret)
-        elif kind == "api_key":
-            if not origin:
-                raise VaultError("origin is required for API key items")
-            norm_origin = normalize_origin(origin)
-            if urlsplit(norm_origin).scheme != "https":
-                raise VaultError("API key items require an HTTPS origin")
-            key = secret.get("api_key")
-            if set(secret) != {"api_key"} or not isinstance(key, str) or not key.strip() or len(key) > 4096:
-                raise VaultError("API key items require only a nonempty API key")
-            secret = {"api_key": key}
-        else:
-            allowed = PAYMENT_FIELDS if kind == "payment" else ADDRESS_FIELDS
-            secret = {k: str(v) for k, v in secret.items() if k in allowed and str(v or "").strip()}
-            missing = [f for f in REQUIRED_FIELDS[kind] if f not in secret]
-            if missing:
-                raise VaultError(f"{kind} items require {', '.join(missing)}")
-            if origin:
-                norm_origin = normalize_origin(origin)
-
-        item_id = self.id_for_key(idempotency_key) if idempotency_key else f"vault_{uuid.uuid4().hex[:12]}"
-        record = {
-            "id": item_id,
-            "kind": kind,
-            "label": label,
-            "origin": norm_origin,
-            "created_at": datetime.now(timezone.utc).isoformat(),
-            "identifier_type": identifier_type,
-            "identifier": identifier,
-            "secret": dict(secret),
-        }
-        if login_method == "sms":
-            record["login_method"] = "sms"
-        with self._locked():
-            items = self._read_all()
-            if idempotency_key:
-                for existing in items:
-                    if existing.get('id') == item_id:
-                        if (existing.get('login_method', 'password') != login_method or
-                                any(existing.get(field) != record[field] for field in
-                                    ('kind', 'label', 'origin', 'identifier_type', 'identifier')) or
-                                (login_method == 'sms' and existing.get('secret') != secret)):
-                            raise VaultError('idempotency key belongs to a different item')
-                        return self._meta(existing)
-            items.append(record)
-            self._write_all(items)
-        return self._meta(record)
