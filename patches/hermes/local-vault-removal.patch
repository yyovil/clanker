-    id: str
-    kind: str
-    label: str
-    origin: Optional[str]
-    created_at: str
-    identifier_type: Optional[str] = None
-    identifier: Optional[str] = None
-    has_otp: bool = False  # a TOTP seed is stored: 2FA codes can be minted without asking the user
