+class TestNAT64WellKnownPrefix:
+    @pytest.mark.parametrize('ipv4', ['8.8.8.8', '34.193.104.167'])
+    def test_public_ipv4_is_allowed_and_dialed_as_the_resolved_nat64_address(self, ipv4, monkeypatch):
+        monkeypatch.setenv('HERMES_ALLOW_PRIVATE_URLS', 'false')
+        _reset_allow_private_cache()
+        wrapped = str(ipaddress.IPv6Address(int(ipaddress.IPv6Address('64:ff9b::')) | int(ipaddress.IPv4Address(ipv4))))
+        with _resolves_to(wrapped):
+            assert is_safe_url('https://public.example/') is True
+            assert _resolved_http_connect_ips('public.example',443,'https') == [wrapped]
+
+    @pytest.mark.parametrize('ipv4', ['127.0.0.1', '10.0.0.1', '192.168.1.1', '100.64.0.1', '0.0.0.0', '224.0.0.1'])
+    def test_private_or_special_ipv4_remains_denied(self, ipv4, monkeypatch):
+        monkeypatch.setenv('HERMES_ALLOW_PRIVATE_URLS', 'false')
+        _reset_allow_private_cache()
+        wrapped = str(ipaddress.IPv6Address(int(ipaddress.IPv6Address('64:ff9b::')) | int(ipaddress.IPv4Address(ipv4))))
+        with _resolves_to(wrapped):
+            assert is_safe_url('https://private.example/') is False
+            with pytest.raises(SSRFConnectionBlocked):
+                _resolved_http_connect_ips('private.example',443,'https')
+
+    @pytest.mark.parametrize('ipv4', ['169.254.169.254', '100.100.100.200'])
+    def test_metadata_remains_always_denied(self, ipv4, monkeypatch):
+        monkeypatch.setenv('HERMES_ALLOW_PRIVATE_URLS', 'true')
+        _reset_allow_private_cache()
+        wrapped = str(ipaddress.IPv6Address(int(ipaddress.IPv6Address('64:ff9b::')) | int(ipaddress.IPv4Address(ipv4))))
+        with _resolves_to(wrapped):
+            assert is_always_blocked_url('https://metadata.example/') is True
+            assert is_safe_url('https://metadata.example/') is False
+        _reset_allow_private_cache()
+
+
 class _FakeResponse:
     """Minimal stand-in for an httpx response as seen inside a response hook."""
 
