+@pytest.mark.asyncio
+async def test_human_reply_during_recovery_authorization_wins(workspace, monkeypatch):
+    await provision(workspace)
+    _, transfer, form, misplaced, _ = await legacy_task(workspace)
+    restored = restart(workspace)
+    validate = restored.channel_tasks.validate_destination
