#!/usr/bin/env python3
"""Preview or apply public-discovery settings without restarting the gateway."""
import argparse
import json
import os
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
PYTHON = ROOT / '.local/hermes-lab/venv/bin/python'
if Path(sys.prefix).resolve() != PYTHON.parent.parent.resolve():
    os.execv(str(PYTHON), [str(PYTHON), __file__, *sys.argv[1:]])
sys.path[:0] = [str(ROOT / 'runtime'), str(ROOT / 'hermes')]
from public_web.rollout import rollout


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--home', type=Path, default=ROOT / '.local/hermes-lab/home')
    parser.add_argument('--apply', action='store_true', help='Apply the previewed discovery setting to existing owned profiles.')
    args = parser.parse_args()
    print(json.dumps({'profiles': rollout(args.home, apply=args.apply),
                      'gateway_restarted': False, 'sessions_reset': False}, indent=2))


if __name__ == '__main__':
    main()
