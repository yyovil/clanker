#!/usr/bin/env python3
"""Prepare terminal isolation and the trusted Kernel driver; no local browser."""
import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'runtime'))
from seatbelt.install import prepare_fleet, install_context

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--home', type=Path, required=True)
parser.add_argument('--node', type=Path, required=True, help='Existing Node executable.')
parser.add_argument('--agent-browser-package', type=Path, required=True,
                    help='Existing agent-browser package containing bin/agent-browser-darwin-arm64.')
args = parser.parse_args()
home = args.home.resolve(strict=True)
homes = [home] + sorted(p for p in (home / 'profiles').iterdir() if (p / 'config.yaml').is_file())
receipt = {'installed_executables': {'node': str(args.node.resolve(strict=True)),
           'agent_browser_package': str(args.agent_browser_package.resolve(strict=True))},
           'profiles': [{'name': 'default' if p == home else p.name, 'home': str(p)} for p in homes]}
fleet = prepare_fleet(args.home, receipt)
for profile in receipt['profiles']:
    install_context(profile['home'], fleet)
    print(json.dumps({'profile': profile['name'], 'primitive_boundary': 'passed', 'slack_tools_enabled': False}))
